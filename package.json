{
  "name": "nuxt-ui-template-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ./node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "bun ./node_modules/nuxt/bin/nuxt.mjs dev",
    "preview": "bun ./node_modules/nuxt/bin/nuxt.mjs preview",
    "start": "bun .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun ./node_modules/nuxt/bin/nuxt.mjs typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "cross-env RUN_PG_INTEGRATION=1 vitest run tests/integration/postgres-connection.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.4",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/vue": "^3.0.5",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/simple-icons": "^1.2.63",
    "@noble/hashes": "^2.0.1",
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "ai": "^6.0.5",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "^0.5.26",
    "nuxt-og-image": "^6.5.0",
    "pg": "^8.16.3",
    "shiki-stream": "^0.1.3",
    "steg": "^0.1.5",
    "vue": "3.5.34",
    "zod": "^3.24.0"
  },
  "patchedDependencies": {
    "micro-aes-gcm@0.3.3": "patches/micro-aes-gcm+0.3.3.patch",
    "steg@0.1.5": "patches/steg+0.1.5.patch"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.2.16",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.0"
  },
  "packageManager": "bun@1.3.6"
}
