# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# PostgreSQL（二选一；连接串优先，见 server/utils/pg-pool-options.ts）
#
# 【方式 A】连接串（含特殊符号时请做 URL 编码）
# 云上常带 TLS：sslmode=require；本地默认无 TLS：sslmode=disable，或直接去掉查询串
# NUXT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# 或未设时用 DATABASE_URL=
#
# 【方式 B】拆分变量
# NUXT_PG_HOST=HOST
# NUXT_PG_PORT=PORT
# NUXT_PG_USER=USER
# NUXT_PG_PASSWORD=PASSWORD
# NUXT_PG_DATABASE=DBNAME
# 云上常带 TLS，NUXT_PG_SSL=require；本地无 TLS：不要设 require，或 NUXT_PG_SSL=disable
# NUXT_PG_SSL=disable

# Vitest 连真库：bun run test:pg 前 RUN_PG_INTEGRATION=1

# GitHub OAuth (required for Drive / Iskra login)
# Create an OAuth App at https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:3000/auth/github (dev) or https://your-domain.com/auth/github (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=your_client_id_here
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_client_secret_here
