# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# PostgreSQL（二选一；连接串优先，见 server/utils/pg-pool-options.ts）
#
# 【方式 A】连接串（含特殊符号时请做 URL 编码）
# 云上常带 TLS：sslmode=require；本地默认无 TLS：sslmode=disable，或直接去掉查询串
# NUXT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# 或未设时用 DATABASE_URL=
#
# 【方式 B】拆分变量
# NUXT_PG_HOST=HOST
# NUXT_PG_PORT=PORT
# NUXT_PG_USER=USER
# NUXT_PG_PASSWORD=PASSWORD
# NUXT_PG_DATABASE=DBNAME
# 云上常带 TLS，NUXT_PG_SSL=require；本地无 TLS：不要设 require，或 NUXT_PG_SSL=disable
# NUXT_PG_SSL=disable

# Vitest 连真库：bun run test:pg 前 RUN_PG_INTEGRATION=1

# GitHub OAuth (required for Drive / Iskra login)
# Create an OAuth App at https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:3000/auth/github (dev) or https://your-domain.com/auth/github (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=your_client_id_here
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_client_secret_here

# Iskra：仅「生成会话标题」使用 OpenAI 兼容 API（三者都填则启用；否则标题仍用 AI Gateway 的 gpt-4o-mini）
# BASE_URL 一般为服务根路径，如 https://api.openai.com/v1 或 http://127.0.0.1:11434/v1（标题请求走 /v1/chat/completions，非 /v1/responses）
#API_KEY=
#BASE_URL=
#MODEL=

# Iskra：正文对话转发到本机 iskra-engine（POST {origin}/rag/query，JSON body: { query }）
# 默认 http://127.0.0.1:8000；本机 uvicorn 监听 127.0.0.1:8000 时可不填
NUXT_ISKRA_ENGINE_URL=http://127.0.0.1:8000

# Iskra / Drive 内测邀请码（仅服务端；POST /api/beta/unlock 校验）。不设则解锁接口返回 503。
NUXT_BETA_APPS_INVITE_CODE=your_secret_invite_string

# Bun / Nitro：HTTP 连接空闲超时（秒）。默认约 10 秒会断连，最大只能是 255 秒。Nitro v2.13.x 才有该配置项。
# Iskra 会先等服务端完整请求 iskra-engine，再开始向下游写流。但如果等待时间过长，大于连接空闲超时会触发「request timed out after 10 seconds」。
NITRO_BUN_IDLE_TIMEOUT=180
